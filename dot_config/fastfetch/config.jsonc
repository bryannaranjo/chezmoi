{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": { "top": 2 }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        { "type": "title", "color": { "user": "32", "host": "32" } },

        { "type": "custom", "format": "{#32}┌───────── Hardware ─────────┐" },
        { "type": "cpu", "key": "{#32}│{#} 󰻠", "format": "{name}" },
        { "type": "gpu", "key": "{#32}│{#} 󰢮", "format": "{name}" },
        { "type": "memory", "key": "{#32}│{#} 󰍛" },
        { "type": "disk", "key": "{#32}│{#} 󰋊", "folders": "/" },
        { "type": "custom", "format": "{#32}└─────────────────────────────┘" },

        { "type": "custom", "format": "{#33}┌──────────── Software ────────────┐" },
        { "type": "os", "key": "{#33}│{#} 󰍹" },
        { "type": "kernel", "key": "{#33}│{#} 󰒋" },
        { "type": "packages", "key": "{#33}│{#} 󰏖" },
        { "type": "terminal", "key": "{#33}│{#} " },
        { "type": "shell", "key": "{#33}│{#} 󰞷" },

        { "type": "de", "key": "{#34}│{#} 󰧨" },
        { "type": "wm", "key": "{#34}│{#} 󱂬" },
        { "type": "wmtheme", "key": "{#34}│{#} 󰉼" },
        { "type": "icons", "key": "{#34}│{#} 󰀻" },
        { "type": "terminalfont", "key": "{#34}│{#} 󰛖" },
        { "type": "custom", "format": "{#34}└───────────────────────────────────┘" },

        { "type": "custom", "format": "{#35}┌───── Uptime / Age ─────┐" },
        { "type": "uptime", "key": "{#35}│{#} Uptime" },
        { "type": "custom", "format": "{#35}└─────────────────────────┘" },

        "break",
        "colors"
    ]
}
