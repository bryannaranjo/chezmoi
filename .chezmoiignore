# Windows-only yazi config (this machine's own ~/.config/yazi is managed separately below)
{{- if ne .chezmoi.os "windows" }}
AppData/Roaming/yazi/**
{{- end }}

# Linux/macOS yazi config (symlinked into ~/dots/yazi)
{{- if eq .chezmoi.os "windows" }}
.config/yazi/**
{{- end }}

# Windows-only vlc config (lua extension)
{{- if ne .chezmoi.os "windows" }}
AppData/Roaming/vlc/**
{{- end }}

# Linux/macOS vlc config (vlcrc, symlinked into ~/dots/vlc)
{{- if eq .chezmoi.os "windows" }}
.config/vlc/**
{{- end }}

# Windows-only tools (use ~/.config path convention on Windows, no Linux/macOS equivalent)
{{- if ne .chezmoi.os "windows" }}
.config/komorebi/**
.config/powershell/**
.config/yasb/**
{{- end }}

# Linux/macOS-only configs. Several are symlinks into ~/dots, which Windows
# can't create without Developer Mode (and ~/dots doesn't exist there).
{{- if eq .chezmoi.os "windows" }}
.config/kitty/**
.config/kitty
.config/neofetch
.config/tmux
.config/terminator/**
.zshrc
{{- end }}
